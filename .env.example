APP_NAME=TicketLab
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DATABASE_URL=
DB_SSLMODE=require
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Images (logos, banners, speaker photos, gallery) are uploaded from the browser straight to Cloudinary.
# cloudinary://<api_key>:<api_secret>@<cloud_name> from the Cloudinary console (API Keys). Leave empty to disable
# uploads; pasted https image links still work. Assets go under ticketlab/{APP_ENV}/orgs/{org_id}/...
CLOUDINARY_URL=
# Only if images were uploaded before Cloudinary: the public address of that bucket, e.g. https://media.example.com
LEGACY_MEDIA_URL=
# Only while images stored by the earlier Cloudinary setup (Flysystem disk) are not yet converted with
# `php artisan media:convert-legacy-cloudinary --execute`: MEDIA_DISK=cloudinary plus that setup's folder.
MEDIA_DISK=
CLOUDINARY_FOLDER=
# Content-Security-Policy (config/csp.php): off, report-only (logs violations in the browser console) or enforce.
CSP_MODE=off
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email. Locally "log" writes emails to storage/logs. Production uses Brevo's HTTP API (POST /v3/smtp/email):
# MAIL_MAILER=brevo and the account's API key (Brevo > SMTP & API > API keys, starts with xkeysib-).
# No SMTP key and no SMTP login are involved.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# The xkeysib- key. Unset, every send fails with a clear error.
BREVO_API_KEY=
# Seconds before a slow API request gives up; the cron retries the email.
MAIL_TIMEOUT=8
# Must be a sender verified in Brevo > Senders.
MAIL_FROM_ADDRESS="tickets@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Emails a day the provider allows, across every kind (Brevo free plan: 300; Starter: no cap, set a large number).
BREVO_DAILY_LIMIT=300
# Percent of that limit each kind may use (counted against everything sent today). Tickets stop at 90% so invitations
# and payout alerts still go out on a big ticket day.
MAIL_SHARE_TRANSACTIONAL=100
MAIL_SHARE_TICKET=90
MAIL_SHARE_ZONE_CHOICE=70
MAIL_SHARE_BROADCAST=50

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# Vercel & Serverless Cron/Migration Token
SCHEDULER_TOKEN=

SMS_ENABLED=false
SMS_DRIVER=null
SMS_SENDER_ID=TicketLab
SMS_LOG_CHANNEL=single
MNOTIFY_API_KEY=
MNOTIFY_ENDPOINT=https://api.mnotify.com/api/sms/quick
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

VITE_APP_NAME="${APP_NAME}"
